{
  "name": "todolist-feed-app-express",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "npx tsx watch --env-file=.env src/server.ts",
    "db:generate-migration": "npx drizzle-kit generate",
    "db:apply-migrations": "source .env && export DATABASE_URL && npx drizzle-kit migrate",
    "db:psql-connect": "source .env && psql $DATABASE_URL",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
